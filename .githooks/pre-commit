#!/usr/bin/env python3
"""
Local pre-commit security scanner.
Blocks commits that contain hardcoded secrets, private keys, or tokens.
Scans the STAGED content (via `git show :path`), not the working tree.
"""
import subprocess
import sys
import re

# ---------- Configuration ----------

# Paths / suffixes to skip entirely (docs, fixtures, lockfiles, etc.)
EXCLUDE_SUFFIXES = ('.md', '.rst', '.lock', '.sum', '.png', '.jpg', '.jpeg',
                    '.gif', '.svg', '.ico', '.pdf', '.zip', '.gz', '.tar')
EXCLUDE_DIRS = ('docs/', 'doc/', 'tests/fixtures/', 'testdata/',
                'vendor/', 'node_modules/', 'dist/', 'build/', '.venv/',
                'venv/', '__pycache__/')
EXCLUDE_FILENAMES = ('.env.example', '.env.sample', '.env.template',
                     'package-lock.json', 'yarn.lock', 'poetry.lock')

# Values that are obviously placeholders (won't trigger generic patterns)
PLACEHOLDER_RE = re.compile(
    r'^(changeme|example|placeholder|your[_-]?\w*|xxx+|todo|redacted|'
    r'<[^>]+>|\$\{[^}]+\}|\{\{[^}]+\}\})',
    re.IGNORECASE
)

# High-confidence secret patterns (specific formats)
STRICT_PATTERNS = [
    ('OpenAI key',        re.compile(r'sk-[A-Za-z0-9]{20,}')),
    ('GitHub token',      re.compile(r'gh[pousr]_[A-Za-z0-9]{36,}')),
    ('AWS access key',    re.compile(r'AKIA[0-9A-Z]{16}')),
    ('Slack token',       re.compile(r'xox[abprs]-[A-Za-z0-9-]{10,}')),
    ('Stripe live key',   re.compile(r'[sr]k_live_[A-Za-z0-9]{20,}')),
    ('Private key',       re.compile(r'-----BEGIN (RSA|EC|DSA|OPENSSH|PGP)? ?PRIVATE KEY-----')),
    ('JWT',               re.compile(r'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}')),
]

# Generic assignment patterns (tighter: require 8+ char value, skip placeholders)
GENERIC_PATTERNS = [
    ('Hardcoded password', re.compile(
        r'''(?:password|passwd|pwd)\s*[:=]\s*["']([^"']{8,})["']''', re.IGNORECASE)),
    ('Hardcoded secret',   re.compile(
        r'''(?:secret|api[_-]?key|access[_-]?token|auth[_-]?token)\s*[:=]\s*["']([^"']{12,})["']''',
        re.IGNORECASE)),
]

# ---------- Helpers ----------

def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)

def staged_files():
    """Return list of staged file paths (added/copied/modified only)."""
    r = run(['git', 'diff', '--cached', '--name-only', '--diff-filter=ACM'])
    return [f for f in r.stdout.splitlines() if f.strip()]

def staged_content(path):
    """Return the STAGED content of a file, or None if binary/unreadable."""
    r = subprocess.run(['git', 'show', f':{path}'],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    return r.stdout

def excluded(path):
    if path in EXCLUDE_FILENAMES:
        return True
    if any(path.endswith(s) for s in EXCLUDE_SUFFIXES):
        return True
    if any(path.startswith(d) for d in EXCLUDE_DIRS):
        return True
    return False

def is_placeholder(value):
    return bool(PLACEHOLDER_RE.match(value.strip()))

# ---------- Scan ----------

def scan():
    print("🛡️  Running native Python security & secret scan...")
    files = staged_files()
    if not files:
        print("ℹ️  No staged files to scan.")
        return 0

    violations = 0

    for path in files:
        if excluded(path):
            continue

        content = staged_content(path)
        if content is None:
            continue  # binary or unreadable — skip silently

        # Split for line numbers
        for lineno, line in enumerate(content.splitlines(), 1):
            # Strict patterns — any match is a violation
            for label, pat in STRICT_PATTERNS:
                if pat.search(line):
                    print(f"❌ [{label}] {path}:{lineno}")
                    violations += 1

            # Generic patterns — check placeholder exclusion
            for label, pat in GENERIC_PATTERNS:
                m = pat.search(line)
                if m and not is_placeholder(m.group(1)):
                    print(f"❌ [{label}] {path}:{lineno}")
                    violations += 1

    if violations:
        print(f"\n❌ Commit rejected: {violations} potential secret(s) detected.")
        print("   Fix the issue or bypass with: git commit --no-verify")
        return 1

    print("✅ Security scan passed. Proceeding with commit.")
    return 0

if __name__ == '__main__':
    sys.exit(scan())
